# Optional contact form (EmailJS, free tier). Copy to .env and fill in.
# When any value is missing, the form is not rendered and visitors see the email link only.
PUBLIC_EMAILJS_SERVICE_ID=
PUBLIC_EMAILJS_TEMPLATE_ID=
PUBLIC_EMAILJS_PUBLIC_KEY=

# Search engine ownership tokens (see README, "Search engines"). Leave empty until you verify.
PUBLIC_GOOGLE_SITE_VERIFICATION=
PUBLIC_BING_SITE_VERIFICATION=
