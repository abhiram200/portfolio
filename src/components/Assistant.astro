---
// The portfolio assistant: a robot who peeks out of the corner and opens the
// chat. The chat engine is loaded only when it is first opened or hovered.
import { person } from '../data/profile.js';
import { assistant } from '../data/assistant.js';
---

<div class="bit" id="bit" data-state="peek">
  <div class="bubble" id="bit-bubble" aria-hidden="true">
    <p id="bit-bubble-text"></p>
    <span class="bubble-hint">Click to open it in the chat</span>
  </div>
  <p class="visually-hidden" id="bit-live" aria-live="polite"></p>

  <span class="grip" aria-hidden="true"><i></i><i></i><i></i></span>
  <button class="launcher" id="bit-launcher" type="button" aria-expanded="false" aria-controls="bit-panel">
    <span class="visually-hidden">Chat with {assistant.name}, {assistant.role}</span>
    <svg class="robot" viewBox="0 0 120 130" aria-hidden="true">
      <line x1="60" y1="24" x2="60" y2="9" stroke="#8b6cff" stroke-width="4" stroke-linecap="round"></line>
      <circle class="antenna" cx="60" cy="8" r="6" fill="#ffd166"></circle>
      <rect x="4" y="46" width="12" height="24" rx="5" fill="#ff6fb5"></rect>
      <rect x="104" y="46" width="12" height="24" rx="5" fill="#ff6fb5"></rect>
      <rect x="12" y="22" width="96" height="74" rx="28" fill="#2a2470" stroke="#8b6cff" stroke-width="3"></rect>
      <rect x="24" y="36" width="72" height="44" rx="17" fill="#0b0925"></rect>
      <g class="eyes">
        <g class="eye-l"><ellipse cx="45" cy="56" rx="7.5" ry="8.5" fill="#7fe7ff"></ellipse></g>
        <g class="eye-r"><ellipse cx="75" cy="56" rx="7.5" ry="8.5" fill="#7fe7ff"></ellipse></g>
      </g>
      <path class="mouth" d="M51 70 Q60 76 69 70" stroke="#7fe7ff" stroke-width="3" fill="none" stroke-linecap="round"></path>
      <rect x="34" y="98" width="52" height="30" rx="12" fill="#2a2470" stroke="#8b6cff" stroke-width="3"></rect>
      <circle cx="60" cy="113" r="5" fill="#ffd166"></circle>
    </svg>
  </button>

  <section class="panel" id="bit-panel" role="dialog" aria-labelledby="bit-title" aria-describedby="bit-desc" hidden>
    <div class="panel-head">
      <svg class="mini" viewBox="0 0 120 100" aria-hidden="true">
        <rect x="12" y="10" width="96" height="74" rx="28" fill="#2a2470" stroke="#8b6cff" stroke-width="4"></rect>
        <rect x="24" y="24" width="72" height="44" rx="17" fill="#0b0925"></rect>
        <ellipse cx="45" cy="44" rx="7.5" ry="8.5" fill="#7fe7ff"></ellipse>
        <ellipse cx="75" cy="44" rx="7.5" ry="8.5" fill="#7fe7ff"></ellipse>
      </svg>
      <div>
        <h2 id="bit-title">{assistant.name}</h2>
        <p id="bit-desc"><span class="online" aria-hidden="true"></span><span class="visually-hidden">Online. </span>{assistant.role}</p>
      </div>
      <button class="close" id="bit-close" type="button">
        <span class="visually-hidden">Close chat</span>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"></path></svg>
      </button>
    </div>

    <div class="log" id="bit-log" role="log" aria-label="Conversation" tabindex="0">
      <div class="msg bot">
        <p>Hi, I’m {assistant.name}! Ask me anything about Abhiram: what he’s working on, his projects, skills, or how to get in touch.</p>
      </div>
    </div>

    <ul class="suggest" id="bit-suggest" aria-label="Suggested questions"></ul>

    <form class="ask" id="bit-form">
      <label for="bit-input" class="visually-hidden">Your question</label>
      <input id="bit-input" type="text" autocomplete="off" maxlength="300" placeholder="Ask a question…" />
      <button class="send" type="submit">
        <span class="visually-hidden">Send</span>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="2.4" fill="none" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      </button>
    </form>
  </section>
</div>

<script>
  import { unlock, reducedMotion } from '../scripts/game.js';
  import { markExternal } from '../scripts/links.js';
  import { suggestions, followUps } from '../data/suggestions.js';
  import { assistant } from '../data/assistant.js';

  const NAME = assistant.name;

  const root = document.getElementById('bit')!;
  const launcher = document.getElementById('bit-launcher') as HTMLButtonElement;
  const panel = document.getElementById('bit-panel')!;
  const closeBtn = document.getElementById('bit-close')!;
  const log = document.getElementById('bit-log')!;
  const form = document.getElementById('bit-form') as HTMLFormElement;
  const input = document.getElementById('bit-input') as HTMLInputElement;
  const suggestList = document.getElementById('bit-suggest')!;
  const bubble = document.getElementById('bit-bubble')!;
  const bubbleText = document.getElementById('bit-bubble-text')!;
  const live = document.getElementById('bit-live')!;
  const eyes = root.querySelector('.eyes') as SVGGElement;

  type Link = { label: string; href: string };
  type Bot = typeof import('../scripts/bot.js');
  let botPromise: Promise<Bot> | null = null;
  const loadBot = () => (botPromise ??= import('../scripts/bot.js'));
  launcher.addEventListener('pointerenter', loadBot, { once: true });
  launcher.addEventListener('focus', loadBot, { once: true });

  // ---- notes: bug stories, kept so they can be read again in the chat -------
  const NOTES = 'ar-bit-notes';
  const readNotes = (): string[] => {
    try {
      return JSON.parse(localStorage.getItem(NOTES) ?? '[]');
    } catch {
      return [];
    }
  };
  const saveNote = (text: string) => {
    try {
      localStorage.setItem(NOTES, JSON.stringify([...readNotes(), text]));
    } catch {
      /* ignore */
    }
  };

  // ---- speech bubble -------------------------------------------------------
  // Stays longer for longer messages, pauses while hovered, and clicking it
  // opens the chat where the same message is waiting.
  let bubbleTimer = 0;
  let bubbleMs = 6000;
  const hideLater = (ms: number) => {
    clearTimeout(bubbleTimer);
    bubbleTimer = window.setTimeout(() => {
      if (root.dataset.state === 'talk') root.dataset.state = 'peek';
    }, ms);
  };
  const say = (text: string, announce = true) => {
    if (!panel.hidden) return;
    bubbleText.textContent = text;
    root.dataset.state = 'talk';
    if (announce) live.textContent = text;
    bubbleMs = Math.min(18000, Math.max(6000, text.length * 75));
    hideLater(bubbleMs);
  };
  bubble.addEventListener('pointerenter', () => clearTimeout(bubbleTimer));
  bubble.addEventListener('pointerleave', () => hideLater(3500));
  bubble.addEventListener('click', () => open());
  // Tapping anywhere else dismisses the bubble.
  document.addEventListener('pointerdown', (e) => {
    if (root.dataset.state !== 'talk' || root.contains(e.target as Node)) return;
    clearTimeout(bubbleTimer);
    root.dataset.state = 'peek';
  });

  // ---- open / close --------------------------------------------------------
  const open = () => {
    clearTimeout(bubbleTimer);
    root.dataset.state = 'open';
    panel.hidden = false;
    launcher.setAttribute('aria-expanded', 'true');
    log.scrollTop = log.scrollHeight;
    input.focus();
    loadBot();
  };
  const close = () => {
    panel.hidden = true;
    root.dataset.state = 'peek';
    launcher.setAttribute('aria-expanded', 'false');
    launcher.focus();
  };
  launcher.addEventListener('click', () => (panel.hidden ? open() : close()));
  closeBtn.addEventListener('click', close);
  panel.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') close();
  });
  document.addEventListener('bit:open', () => open());
  document.querySelectorAll('[data-open-bit]').forEach((el) => el.addEventListener('click', () => open()));

  // ---- messages ------------------------------------------------------------
  const scrollDown = () => log.scrollTo({ top: log.scrollHeight, behavior: reducedMotion() ? 'auto' : 'smooth' });

  const bubbleEl = (who: 'you' | 'bot' | 'note') => {
    const msg = document.createElement('div');
    msg.className = `msg ${who}`;
    const p = document.createElement('p');
    const label = document.createElement('span');
    label.className = 'visually-hidden';
    label.textContent = who === 'you' ? 'You asked: ' : `${NAME}: `;
    p.append(label);
    msg.append(p);
    log.append(msg);
    return { msg, p };
  };

  const addLinks = (msg: HTMLElement, links: Link[]) => {
    if (!links.length) return;
    const ul = document.createElement('ul');
    ul.className = 'msg-links';
    for (const l of links) {
      const li = document.createElement('li');
      li.append(Object.assign(document.createElement('a'), { href: l.href, textContent: l.label }));
      ul.append(li);
    }
    msg.append(ul);
    markExternal(msg);
  };

  const addText = (who: 'you' | 'note', text: string) => {
    const { p } = bubbleEl(who);
    p.append(text);
    scrollDown();
  };

  // Streams an answer word by word, the way a live assistant types.
  let finishStream: (() => void) | null = null;
  const streamAnswer = (text: string, links: Link[]) =>
    new Promise<void>((resolve) => {
      finishStream?.();
      const { msg, p } = bubbleEl('bot');
      const words = text.split(/(\s+)/);
      const out = document.createTextNode('');
      p.append(out);
      const done = () => {
        out.textContent = text;
        msg.classList.remove('streaming');
        addLinks(msg, links);
        log.setAttribute('aria-busy', 'false');
        finishStream = null;
        scrollDown();
        resolve();
      };
      if (reducedMotion()) return done();
      log.setAttribute('aria-busy', 'true');
      msg.classList.add('streaming');
      const step = Math.max(8, Math.min(32, 1600 / words.length));
      let i = 0;
      let last = 0;
      const tick = (now: number) => {
        if (finishStream !== done) return;
        if (now - last >= step) {
          last = now;
          i = Math.min(words.length, i + 2);
          out.textContent = words.slice(0, i).join('');
          log.scrollTop = log.scrollHeight;
        }
        if (i >= words.length) done();
        else requestAnimationFrame(tick);
      };
      finishStream = done;
      requestAnimationFrame(tick);
    });

  const typing = () => {
    const { msg, p } = bubbleEl('bot');
    msg.classList.add('typing');
    p.firstChild!.textContent = `${NAME} is typing`;
    const dots = document.createElement('span');
    dots.className = 'dots';
    dots.setAttribute('aria-hidden', 'true');
    dots.innerHTML = '<i></i><i></i><i></i>';
    p.append(dots);
    scrollDown();
    return msg;
  };

  // ---- suggestions ---------------------------------------------------------
  const asked = new Set<string>();
  // Conversation memory: the current topic and which write-up passages were shown.
  const convo: { topic?: string; lastMore?: string; shown: Set<string> } = { shown: new Set() };
  // True while a bug story is the latest thing in the chat, so a vague
  // "what is this about?" is read as a question about it.
  let noteFresh = false;
  const key = (q: string) => q.toLowerCase().replace(/[’']/g, '').replace(/\b(the|a|an|is|what|does|did|he|his)\b/g, '').replace(/[^a-z0-9]+/g, '');
  const renderChips = (list: string[]) => {
    suggestList.replaceChildren(
      ...list.slice(0, 3).map((q) => {
        const li = document.createElement('li');
        const b = Object.assign(document.createElement('button'), { type: 'button', className: 'chip', textContent: q });
        b.addEventListener('click', () => {
          submit(q);
          input.focus();
        });
        li.append(b);
        return li;
      }),
    );
  };
  // Answers already given, so chips never offer the same answer twice.
  const answered = new Set<string>();
  let askFn: ((q: string) => { answer: string }) | null = null;
  const nextChips = (topic?: string) => {
    const fresh = (l: string[]) => l.filter((q) => !asked.has(key(q)) && !(askFn && answered.has(askFn(q).answer)));
    const list = [...fresh(topic ? followUps[topic as keyof typeof followUps] ?? [] : []), ...fresh(suggestions)];
    renderChips(list);
  };
  nextChips();

  // ---- asking --------------------------------------------------------------
  const submit = async (q: string) => {
    const question = q.trim();
    if (!question) return;
    finishStream?.();
    asked.add(key(question));
    addText('you', question);
    input.value = '';
    root.classList.add('thinking');
    const dots = reducedMotion() ? null : typing();
    const [{ ask }] = await Promise.all([loadBot(), new Promise((r) => setTimeout(r, reducedMotion() ? 0 : 450))]);
    askFn = (q: string) => ask(q);
    const r = ask(question, { ...convo, notes: readNotes(), noteFresh });
    noteFresh = false;
    answered.add(r.answer);
    if (r.topic) convo.topic = r.topic;
    convo.lastMore = r.more;
    (r.passageIds ?? []).forEach((id: string) => convo.shown.add(id));
    dots?.remove();
    root.classList.remove('thinking');
    unlock('chat');
    nextChips(r.topic);
    await streamAnswer(r.answer, r.links);
  };

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    submit(input.value);
  });

  // ---- personality ---------------------------------------------------------
  // Eyes follow the pointer.
  let raf = 0;
  window.addEventListener(
    'pointermove',
    (e) => {
      if (raf || reducedMotion()) return;
      raf = requestAnimationFrame(() => {
        raf = 0;
        const r = launcher.getBoundingClientRect();
        const cx = r.left + r.width / 2;
        const cy = r.top + r.height * 0.42;
        const dx = e.clientX - cx;
        const dy = e.clientY - cy;
        const d = Math.hypot(dx, dy) || 1;
        const k = Math.min(1, d / 300) * 4.5;
        eyes.style.transform = `translate(${(dx / d) * k}px, ${(dy / d) * k}px)`;
      });
    },
    { passive: true },
  );

  // Bug stories from earlier in the visit are waiting in the chat.
  for (const n of readNotes()) addText('note', n);
  noteFresh = readNotes().length > 0;

  // Say hello once per visit.
  let greeted = false;
  try {
    greeted = sessionStorage.getItem('bit-greeted') === '1';
    sessionStorage.setItem('bit-greeted', '1');
  } catch {
    /* ignore */
  }
  if (!greeted) window.setTimeout(() => say(`Hi, I’m ${NAME}. Ask me anything about Abhiram!`, false), 2200);

  document.addEventListener('game:squash', (e) => {
    const { count, fact } = (e as CustomEvent).detail;
    const note = count >= 5 ? `All 5 bugs squashed! ${fact}` : `Bug ${count} of 5 squashed! ${fact}`;
    saveNote(note);
    addText('note', note);
    noteFresh = true;
    say(note);
  });
  document.addEventListener('game:unlock', (e) => {
    const a = (e as CustomEvent).detail;
    if (a.id === 'bugs' || a.id === 'chat') return;
    say(`Achievement unlocked: ${a.title}`);
  });
  document.addEventListener('game:reset', () => {
    try {
      localStorage.removeItem(NOTES);
    } catch {
      /* ignore */
    }
    log.querySelectorAll('.msg.note').forEach((m) => m.remove());
  });
  document.addEventListener('bit:say', (e) => say((e as CustomEvent).detail));
</script>

<style>
  .bit {
    position: fixed;
    right: clamp(0.5rem, 2vw, 1.5rem);
    bottom: 0;
    z-index: 60;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    pointer-events: none;
  }

  .bit > * {
    pointer-events: auto;
  }

  .launcher {
    width: 92px;
    height: 100px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    transform: translateY(46%);
    transition: transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
    filter: drop-shadow(0 8px 24px rgb(139 108 255 / 0.45));
  }

  .launcher:hover,
  .launcher:focus-visible,
  .bit[data-state='talk'] .launcher {
    transform: translateY(6%);
  }

  .launcher:focus-visible {
    outline-offset: -4px;
  }

  .bit[data-state='open'] .launcher {
    display: none;
  }

  .robot {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .eyes {
    transition: transform 0.12s ease-out;
  }

  .eye-l,
  .eye-r {
    transform-box: fill-box;
    transform-origin: center;
  }

  .bubble {
    position: absolute;
    right: 84px;
    bottom: 58px;
    width: max-content;
    max-width: min(300px, calc(100vw - 120px));
    padding: 0.7rem 0.95rem;
    font-size: 0.92rem;
    font-weight: 550;
    line-height: 1.4;
    color: var(--accent-ink);
    background: var(--ink);
    border-radius: 16px 16px 4px 16px;
    box-shadow: 0 12px 30px rgb(0 0 0 / 0.35);
    cursor: pointer;
    opacity: 0;
    transform: translateY(8px) scale(0.96);
    transform-origin: bottom right;
    transition: opacity 0.2s ease, transform 0.25s ease;
    pointer-events: none;
  }

  .bit[data-state='talk'] .bubble {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  .bubble p {
    margin: 0;
  }

  .bubble-hint {
    display: block;
    margin-top: 0.35rem;
    font-size: 0.74rem;
    font-weight: 600;
    color: #5a54a8;
  }

  @media (prefers-reduced-motion: no-preference) {
    .eye-l,
    .eye-r {
      animation: blink 5.5s infinite;
    }

    .antenna {
      animation: glow 2.4s ease-in-out infinite;
    }

    .bit.thinking .antenna {
      animation-duration: 0.5s;
    }

    .bit[data-state='talk'] .launcher {
      animation: wiggle 0.6s ease 0.2s;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .launcher,
    .bubble {
      transition: none;
    }
  }

  @keyframes blink {
    0%, 94%, 100% { transform: scaleY(1); }
    96% { transform: scaleY(0.1); }
  }

  @keyframes glow {
    50% { fill: #ff6fb5; }
  }

  @keyframes wiggle {
    0%, 100% { rotate: 0deg; }
    25% { rotate: -6deg; }
    75% { rotate: 6deg; }
  }

  /* ---- chat panel ---- */
  .panel {
    position: fixed;
    right: clamp(0.5rem, 2vw, 1.5rem);
    bottom: clamp(0.5rem, 2vw, 1.5rem);
    width: min(410px, calc(100vw - 1rem));
    height: min(620px, calc(100dvh - 6rem));
    display: flex;
    flex-direction: column;
    background: #18154a;
    border: 1px solid var(--line);
    border-radius: 22px;
    box-shadow: 0 30px 80px rgb(0 0 0 / 0.55), 0 0 0 1px rgb(139 108 255 / 0.25);
    overflow: hidden;
  }

  .panel[hidden] {
    display: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .panel:not([hidden]) {
      animation: rise 0.32s cubic-bezier(0.34, 1.4, 0.64, 1);
    }
  }

  @keyframes rise {
    from { opacity: 0; transform: translateY(24px) scale(0.97); }
  }

  .panel-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.9rem 0.9rem 0.9rem 1rem;
    background: linear-gradient(135deg, rgb(139 108 255 / 0.35), rgb(255 111 181 / 0.18));
    border-bottom: 1px solid var(--line);
  }

  .mini {
    width: 44px;
    flex: none;
  }

  .panel-head h2 {
    font-size: 1.15rem;
    font-weight: 800;
  }

  .online {
    display: inline-block;
    width: 8px;
    height: 8px;
    margin-right: 0.4rem;
    border-radius: 50%;
    background: #3ad07a;
    box-shadow: 0 0 0 3px rgb(58 208 122 / 0.25);
    vertical-align: 0.05em;
  }

  .panel-head h2 + p {
    font-weight: 600;
  }

  .panel-head p {
    margin: 0.15rem 0 0;
    font-size: 0.8rem;
    color: var(--muted);
    line-height: 1.35;
  }

  .close {
    margin-left: auto;
    flex: none;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    color: var(--ink);
    background: rgb(255 255 255 / 0.06);
    border: 1px solid var(--line);
    border-radius: 12px;
    cursor: pointer;
  }

  .close svg {
    width: 20px;
  }

  .log {
    flex: 1;
    overflow-y: auto;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .log :global(.msg) {
    max-width: 90%;
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .log :global(.msg p) {
    margin: 0;
  }

  .log :global(.msg.you) {
    align-self: flex-end;
    background: var(--accent);
    color: var(--accent-ink);
    font-weight: 600;
    padding: 0.55rem 0.9rem;
    border-radius: 16px 16px 4px 16px;
  }

  .log :global(.msg.bot) {
    align-self: flex-start;
    background: var(--surface-2);
    padding: 0.7rem 0.95rem;
    border-radius: 16px 16px 16px 4px;
  }

  .log :global(.msg.note) {
    align-self: flex-start;
    background: rgb(229 70 143 / 0.14);
    border: 1px solid rgb(255 111 181 / 0.45);
    padding: 0.65rem 0.9rem;
    border-radius: 16px 16px 16px 4px;
  }

  .log :global(.msg.note p::before) {
    content: '🐞 ';
  }

  .log :global(.msg.streaming p::after) {
    content: '';
    display: inline-block;
    width: 0.5em;
    height: 1em;
    margin-left: 2px;
    vertical-align: -0.12em;
    background: var(--accent);
    animation: caret 0.8s steps(2) infinite;
  }

  @keyframes caret {
    50% { opacity: 0; }
  }

  .log :global(.msg.typing .dots) {
    display: inline-flex;
    gap: 4px;
    margin-left: 2px;
  }

  .log :global(.msg.typing .dots i) {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--muted);
    animation: hop 1s ease-in-out infinite;
  }

  .log :global(.msg.typing .dots i:nth-child(2)) { animation-delay: 0.15s; }
  .log :global(.msg.typing .dots i:nth-child(3)) { animation-delay: 0.3s; }

  @keyframes hop {
    0%, 60%, 100% { transform: translateY(0); opacity: 0.5; }
    30% { transform: translateY(-5px); opacity: 1; }
  }

  .log :global(.msg-links) {
    list-style: none;
    padding: 0;
    margin: 0.45rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.9rem;
    font-size: 0.86rem;
    font-weight: 600;
  }

  .log :global(.msg-links li) {
    animation: fade 0.3s ease both;
  }

  @keyframes fade {
    from { opacity: 0; transform: translateY(4px); }
  }

  .log :global(.msg-links a) {
    display: inline-block;
    padding-block: 0.25rem;
  }

  .suggest {
    list-style: none;
    margin: 0;
    padding: 0.6rem 0.75rem 0.1rem;
    display: flex;
