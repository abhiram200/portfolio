---
// A live, draggable knowledge graph of Abhiram's work, in the spirit of SYNAPSE.
// Every node and edge is derived from the stacks in profile.js.
import { projects, experience, person } from '../data/profile.js';
import { url } from '../lib/url.js';

const AREAS = {
  data: ['python', 'scala', 'pyspark', 'sql', 'tidal', 'oracle', 'cloudberry', 'databricks'],
  ai: ['pytorch', 'ollama', 'tree-sitter', 'python-chess', 'stockfish', 'zod', 'playwright', 'vitest'],
  backend: ['node', 'express', 'mongodb', 'postgres', 'prisma', 'aws', 'linux', 'shell', 'vercel', 'github actions', 'websockets', 'node-pty', 'server-sent', 'nextauth', 'pdfkit', 'emailjs', 'typescript'],
  frontend: ['react', 'next.js', 'three.js', 'pyside6', 'wordpress', 'tailwind'],
};
const areaOf = (label: string) => {
  const l = label.toLowerCase();
  for (const [area, keys] of Object.entries(AREAS)) if (keys.some((k) => l.includes(k))) return area;
  return 'tools';
};
const clean = (s: string) => s.replace(/\s*\(.*?\)\s*/g, '').trim();

type N = { id: string; label: string; kind: string; area?: string; href?: string };
const nodes: N[] = [{ id: 'me', label: person.name, kind: 'me' }];
const links: [string, string][] = [];
const tech = new Map<string, N>();

const work = [
  ...projects.map((p) => ({ id: p.slug, label: p.name, kind: 'project', href: url(`/work/${p.slug}/`), stack: p.stack })),
  ...experience.map((e) => ({ id: e.id, label: e.org.replace(' Pvt. Ltd.', ''), kind: 'role', href: url('/#experience'), stack: e.stack })),
];
for (const w of work) {
  nodes.push({ id: w.id, label: w.label, kind: w.kind, href: w.href });
  links.push(['me', w.id]);
  for (const s of w.stack) {
    const label = clean(s);
    const id = `t:${label.toLowerCase()}`;
    if (!tech.has(id)) tech.set(id, { id, label, kind: 'tech', area: areaOf(label) });
    links.push([w.id, id]);
  }
}
nodes.push(...tech.values());
const data = JSON.stringify({ nodes, links });
---

<figure class="graph-frame">
  <div class="graph" id="work-graph" data-graph={data}>
    <canvas role="img" aria-label="Interactive graph linking Abhiram's projects and roles to the technologies each one used. The same information is in the project and experience sections below."></canvas>
    <p class="hint" aria-hidden="true">Drag the nodes · click a project to open it</p>
  </div>
  <figcaption>
    <ul class="legend">
      <li><span class="sw project"></span>Projects</li>
      <li><span class="sw role"></span>Roles</li>
      <li><span class="sw" style="--c: var(--c-data)"></span>Data</li>
      <li><span class="sw" style="--c: var(--c-ai)"></span>AI and ML</li>
      <li><span class="sw" style="--c: var(--c-backend)"></span>Backend and cloud</li>
      <li><span class="sw" style="--c: var(--c-frontend)"></span>Frontend</li>
      <li><span class="sw" style="--c: var(--c-tools)"></span>Other tools</li>
    </ul>
  </figcaption>
</figure>

<script>
  import { unlock, reducedMotion } from '../scripts/game.js';

  type Node = {
    id: string; label: string; kind: string; area?: string; href?: string;
    x: number; y: number; vx: number; vy: number; r: number; deg: number; lw: number; fixed?: boolean;
  };

  const el = document.getElementById('work-graph') as HTMLElement | null;
  if (el) {
    const canvas = el.querySelector('canvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    const { nodes: rawNodes, links: rawLinks } = JSON.parse(el.dataset.graph!);
    const css = getComputedStyle(document.documentElement);
    const color = (v: string) => css.getPropertyValue(v).trim();
    const AREA: Record<string, string> = {
      data: color('--c-data'), ai: color('--c-ai'), backend: color('--c-backend'),
      frontend: color('--c-frontend'), tools: color('--c-tools'),
    };

    const nodes: Node[] = rawNodes.map((n: Node) => ({
      ...n,
      x: 0,
      y: 0,
      vx: 0, vy: 0, deg: 0, lw: 0,
      r: n.kind === 'me' ? 15 : n.kind === 'project' ? 11 : n.kind === 'role' ? 9 : 5,
    }));
    const byId = new Map(nodes.map((n) => [n.id, n]));
    const links = rawLinks.map(([a, b]: [string, string]) => ({ a: byId.get(a)!, b: byId.get(b)! }));
    for (const l of links) { l.a.deg++; l.b.deg++; }
    for (const n of nodes) if (n.kind === 'tech') n.r = 4 + Math.min(n.deg, 4) * 1.3;
    const neighbours = new Map<Node, Set<Node>>(nodes.map((n) => [n, new Set()]));
    for (const l of links) { neighbours.get(l.a)!.add(l.b); neighbours.get(l.b)!.add(l.a); }
    const me = byId.get('me')!;
    const big = nodes.filter((n) => n.kind !== 'tech');
    const measure = () => {
      ctx.font = '700 13px "Archivo Variable", system-ui, sans-serif';
      for (const n of nodes) n.lw = ctx.measureText(n.label).width;
    };
    measure();

    // Seed a tidy starting layout: work items on a ring, each technology
    // just outside the first work item that uses it.
    const workNodes = nodes.filter((n) => n.kind === 'project' || n.kind === 'role');
    workNodes.forEach((n, i) => {
      const a = (i / workNodes.length) * Math.PI * 2;
      n.x = Math.cos(a) * 160;
      n.y = Math.sin(a) * 160;
    });
    for (const n of nodes) {
      if (n.kind !== 'tech') continue;
      const owner = [...neighbours.get(n)!].find((m) => m.kind !== 'tech');
      const a = Math.random() * Math.PI * 2;
      n.x = (owner?.x ?? 0) * 1.5 + Math.cos(a) * 30;
      n.y = (owner?.y ?? 0) * 1.5 + Math.sin(a) * 30;
    }

    let W = 0, H = 0, dpr = 1, scale = 1;
    const resize = () => {
      const rect = el.getBoundingClientRect();
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      W = rect.width; H = rect.height;
      canvas.width = W * dpr; canvas.height = H * dpr;
      canvas.style.width = `${W}px`; canvas.style.height = `${H}px`;
      scale = Math.min(W, H) / 560;
      kick(0.3);
    };

    // ---- physics ----
    let alpha = 1;
    const tick = () => {
      const k = 34 * Math.max(scale, 0.6);
      for (let i = 0; i < nodes.length; i++) {
        const a = nodes[i];
        for (let j = i + 1; j < nodes.length; j++) {
          const b = nodes[j];
          let dx = b.x - a.x, dy = b.y - a.y;
          const d2 = Math.max(dx * dx + dy * dy, 144);
          const f = Math.min((k * k * 1.1) / d2, 3);
          const d = Math.sqrt(d2);
          dx /= d; dy /= d;
          a.vx -= dx * f * alpha; a.vy -= dy * f * alpha;
          b.vx += dx * f * alpha; b.vy += dy * f * alpha;
        }
      }
      // Keep the big, labelled nodes well apart so their labels have room.
      for (let i = 0; i < big.length; i++) {
        for (let j = i + 1; j < big.length; j++) {
          const a = big[i], b = big[j];
          const dx = b.x - a.x, dy = b.y - a.y;
          const d = Math.hypot(dx, dy) || 0.01;
          const min = 120 * Math.max(scale, 0.62);
          if (d < min) {
            const f = ((min - d) / d) * 0.18;
            a.vx -= dx * f; a.vy -= dy * f;
            b.vx += dx * f; b.vy += dy * f;
          }
        }
      }
      for (const { a, b } of links) {
        const target = (a.kind === 'me' ? 175 : 62) * Math.max(scale, 0.5);
        const dx = b.x - a.x, dy = b.y - a.y;
        const d = Math.hypot(dx, dy) || 0.01;
        const f = ((d - target) / d) * 0.09 * alpha;
        a.vx += dx * f; a.vy += dy * f;
        b.vx -= dx * f; b.vy -= dy * f;
      }
      for (const n of nodes) {
        n.vx -= n.x * 0.006 * alpha; n.vy -= n.y * 0.006 * alpha;
        if (n.fixed) { n.vx = n.vy = 0; continue; }
        n.vx *= 0.8; n.vy *= 0.8;
        const sp = Math.hypot(n.vx, n.vy);
        if (sp > 8) { n.vx *= 8 / sp; n.vy *= 8 / sp; }
        n.x += n.vx; n.y += n.vy;
        const padX = Math.max(n.r + 6, n.kind === 'tech' ? 0 : n.lw / 2 + 6);
        const padY = n.r + 6;
        n.x = Math.max(-W / 2 + padX, Math.min(W / 2 - padX, n.x));
        n.y = Math.max(-H / 2 + padY, Math.min(H / 2 - padY - (n.kind === 'tech' ? 0 : 20), n.y));
      }
      me.x *= 0.9; me.y *= 0.9;
      alpha = Math.max(alpha * 0.993, 0.06);
    };

    // ---- drawing ----
    let hover: Node | null = null;
    let t = 0;
    const draw = () => {
      ctx.setTransform(dpr, 0, 0, dpr, W * dpr / 2, H * dpr / 2);
      ctx.clearRect(-W / 2, -H / 2, W, H);
      const focus = hover ? neighbours.get(hover)! : null;
      for (const { a, b } of links) {
        const lit = hover && (a === hover || b === hover);
        ctx.strokeStyle = lit ? 'rgba(255,209,102,0.85)' : focus ? 'rgba(189,184,234,0.06)' : 'rgba(189,184,234,0.16)';
        ctx.lineWidth = lit ? 1.6 : 1;
        ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(b.x, b.y); ctx.stroke();
      }
      const drawNode = (n: Node, dim: boolean) => {
        ctx.globalAlpha = dim ? 0.22 : 1;
        ctx.beginPath();
        ctx.arc(n.x, n.y, n.r, 0, Math.PI * 2);
        if (n.kind === 'me') {
          const g = ctx.createRadialGradient(n.x, n.y, 2, n.x, n.y, n.r + 10);
          g.addColorStop(0, '#ffffff'); g.addColorStop(0.45, '#8b6cff'); g.addColorStop(1, 'rgba(139,108,255,0)');
          ctx.fillStyle = g; ctx.arc(n.x, n.y, n.r + 10, 0, Math.PI * 2); ctx.fill();
        } else if (n.kind === 'project') {
          ctx.fillStyle = '#110e33'; ctx.fill();
          ctx.lineWidth = 3.2; ctx.strokeStyle = '#ffd166'; ctx.stroke();
          if (!reducedMotion() && !dim) {
            ctx.beginPath(); ctx.arc(n.x, n.y, n.r + 5 + Math.sin(t / 30 + n.x) * 2, 0, Math.PI * 2);
            ctx.lineWidth = 1; ctx.strokeStyle = 'rgba(255,209,102,0.35)'; ctx.stroke();
          }
        } else if (n.kind === 'role') {
          ctx.fillStyle = '#f4f2ff'; ctx.fill();
          ctx.lineWidth = 2; ctx.strokeStyle = '#110e33'; ctx.stroke();
        } else {
          ctx.fillStyle = AREA[n.area ?? 'tools']; ctx.fill();
          ctx.lineWidth = 2; ctx.strokeStyle = '#161340'; ctx.stroke();
        }
      };
      const isDim = (n: Node) => !!focus && n !== hover && !focus.has(n);
      for (const n of nodes) if (isDim(n)) drawNode(n, true);
      for (const n of nodes) if (!isDim(n)) drawNode(n, false);
      ctx.globalAlpha = 1;

      // ---- labels: priority order, four candidate spots, no overlaps ----
      type Box = { x1: number; y1: number; x2: number; y2: number };
      const placed: Box[] = [];
      const hits = (b: Box) => placed.some((p) => b.x1 < p.x2 && b.x2 > p.x1 && b.y1 < p.y2 && b.y2 > p.y1);
      const candidates: { n: Node; pri: number }[] = [];
      for (const n of nodes) {
        if (n === hover) candidates.push({ n, pri: 0 });
        else if (focus?.has(n)) candidates.push({ n, pri: 1 });
        else if (n.kind !== 'tech') candidates.push({ n, pri: focus ? 3 : 2 });
        else if (!focus && n.deg >= 3) candidates.push({ n, pri: 4 });
      }
      candidates.sort((x, y) => x.pri - y.pri);
      ctx.textBaseline = 'middle';
      for (const { n, pri } of candidates) {
        const strong = n.kind !== 'tech';
        const size = strong ? 13 : 11.5;
        ctx.font = `${strong ? 700 : 560} ${size}px "Archivo Variable", system-ui, sans-serif`;
        const w = ctx.measureText(n.label).width;
        const h = size + 4;
        const gap = n.r + (n.kind === 'me' ? 14 : 6);
        const spots = [
          { x: n.x, y: n.y + gap + h / 2, align: 'center' },
          { x: n.x, y: n.y - gap - h / 2, align: 'center' },
          { x: n.x + gap + 2, y: n.y, align: 'left' },
          { x: n.x - gap - 2, y: n.y, align: 'right' },
        ] as const;
        let chosen: (typeof spots)[number] | null = null;
        let box: Box | null = null;
        for (const sp of spots) {
          const x1 = sp.align === 'center' ? sp.x - w / 2 : sp.align === 'left' ? sp.x : sp.x - w;
          const b = { x1: x1 - 3, y1: sp.y - h / 2, x2: x1 + w + 3, y2: sp.y + h / 2 };
          if (b.x1 < -W / 2 || b.x2 > W / 2 || b.y1 < -H / 2 || b.y2 > H / 2) continue;
          if (!hits(b)) { chosen = sp; box = b; break; }
        }
        if (!chosen || !box) continue;
        placed.push(box);
        ctx.globalAlpha = pri === 3 ? 0.35 : 1;
        ctx.textAlign = chosen.align;
        ctx.lineWidth = 4; ctx.strokeStyle = 'rgba(17,14,51,0.92)';
        ctx.strokeText(n.label, chosen.x, chosen.y);
        ctx.fillStyle = strong ? '#f4f2ff' : '#d9d5ff';
        ctx.fillText(n.label, chosen.x, chosen.y);
      }
      ctx.globalAlpha = 1;
    };

    // ---- loop ----
    let running = false;
    const loop = () => {
      t++;
      tick();
      draw();
      if (alpha > 0.065 || drag || (!reducedMotion() && visible)) requestAnimationFrame(loop);
      else running = false;
    };
    const kick = (a = 0.5) => {
      alpha = Math.max(alpha, a);
      if (!running) { running = true; requestAnimationFrame(loop); }
    };

    let visible = true;
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; if (visible) kick(0.05); }).observe(el);

    // ---- pointer ----
    const toLocal = (e: PointerEvent) => {
      const r = canvas.getBoundingClientRect();
      return { x: e.clientX - r.left - W / 2, y: e.clientY - r.top - H / 2 };
    };
    const pick = (p: { x: number; y: number }) => {
      let best: Node | null = null, bd = Infinity;
      for (const n of nodes) {
        const d = Math.hypot(n.x - p.x, n.y - p.y);
        if (d < Math.max(n.r + 10, 16) && d < bd) { best = n; bd = d; }
      }
      return best;
    };
    let drag: Node | null = null;
    let moved = 0;
    canvas.addEventListener('pointerdown', (e) => {
      const n = pick(toLocal(e));
      if (!n) return;
      drag = n; moved = 0; n.fixed = true;
      canvas.setPointerCapture(e.pointerId);
      kick(0.3);
    });
    canvas.addEventListener('pointermove', (e) => {
      const p = toLocal(e);
      if (drag) {
        moved += Math.abs(p.x - drag.x) + Math.abs(p.y - drag.y);
        drag.x = p.x; drag.y = p.y;
        kick(0.25);
        return;
      }
      const n = pick(p);
      if (n !== hover) { hover = n; canvas.style.cursor = n ? (n.href ? 'pointer' : 'grab') : 'default'; draw(); }
    });
    const end = () => {
      if (!drag) return;
      const n = drag;
      n.fixed = false;
      drag = null;
      if (moved < 6 && n.href) {
        unlock('graph');
        window.location.href = n.href;
      } else if (moved >= 6) {
        unlock('graph');
      }
    };
    canvas.addEventListener('pointerup', end);
    canvas.addEventListener('pointercancel', end);
    canvas.addEventListener('pointerleave', () => { if (!drag) { hover = null; draw(); } });

    new ResizeObserver(resize).observe(el);
    resize();
    if (reducedMotion()) {
      for (let i = 0; i < 400; i++) tick();
      draw();
    }
    kick(1);
    document.fonts?.ready.then(() => { measure(); kick(0.2); draw(); });
  }
</script>

<style>
  .graph-frame {
    margin: 0;
    position: relative;
  }

  .graph {
    position: relative;
    height: clamp(430px, 52vw, 600px);
    border-radius: 26px;
    background:
      radial-gradient(circle at 50% 50%, rgb(139 108 255 / 0.18), transparent 65%),
      rgb(22 19 64 / 0.7);
    border: 1px solid var(--line);
    overflow: hidden;
    touch-action: pan-y;
  }

  .graph::before,
  .graph::after {
    content: '';
    position: absolute;
    width: 26px;
    height: 26px;
    border: 2px solid var(--accent);
    pointer-events: none;
    opacity: 0.8;
  }

  .graph::before {
    top: 14px;
    left: 14px;
    border-right: 0;
    border-bottom: 0;
    border-radius: 8px 0 0 0;
  }

  .graph::after {
    bottom: 14px;
    right: 14px;
    border-left: 0;
    border-top: 0;
    border-radius: 0 0 8px 0;
  }

  canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hint {
    position: absolute;
    left: 50%;
    bottom: 14px;
    transform: translateX(-50%);
    margin: 0;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--muted);
    background: rgb(17 14 51 / 0.75);
    padding: 0.3rem 0.8rem;
    border-radius: 999px;
    white-space: nowrap;
    pointer-events: none;
  }

  .legend {
    list-style: none;
    padding: 0;
    margin: 0.85rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1rem;
    font-size: 0.82rem;
    color: var(--muted);
  }

  .legend li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .sw {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--c);
  }

  .sw.project {
    background: var(--bg);
    border: 2.5px solid var(--accent);
    width: 13px;
    height: 13px;
  }

  .sw.role {
    background: var(--ink);
  }
</style>
