---
// Decorative artwork for each project, drawn from what the project does.
interface Props {
  slug: string;
}
const { slug } = Astro.props;
---

<svg class="art" viewBox="0 0 320 180" aria-hidden="true" preserveAspectRatio="xMidYMid slice">
  {
    slug === 'aura' && (
      <g>
        <rect x="40" y="30" width="240" height="124" rx="14" fill="#0b0925" stroke="#8b6cff" stroke-width="2" />
        <circle cx="60" cy="47" r="4" fill="#e5468f" />
        <circle cx="74" cy="47" r="4" fill="#ffd166" />
        <circle cx="88" cy="47" r="4" fill="#2fa85a" />
        <path d="M62 78 l12 10 -12 10" stroke="#7fe7ff" stroke-width="3" fill="none" stroke-linecap="round" />
        <rect x="84" y="94" width="18" height="4" rx="2" fill="#7fe7ff" class="blink" />
        <rect x="62" y="114" width="120" height="5" rx="2.5" fill="#342e7a" />
        <rect x="62" y="127" width="80" height="5" rx="2.5" fill="#342e7a" />
        <g stroke="#ffd166" stroke-width="1.5" opacity="0.9">
          <line x1="220" y1="80" x2="250" y2="110" />
          <line x1="220" y1="80" x2="196" y2="118" />
          <line x1="250" y1="110" x2="196" y2="118" />
          <line x1="250" y1="110" x2="262" y2="74" />
        </g>
        <circle cx="220" cy="80" r="7" fill="#ffd166" />
        <circle cx="250" cy="110" r="6" fill="#1f9cc6" />
        <circle cx="196" cy="118" r="5" fill="#e5468f" />
        <circle cx="262" cy="74" r="5" fill="#2fa85a" />
      </g>
    )
  }
  {
    slug === 'synapse' && (
      <g>
        <g stroke="#bdb8ea" stroke-opacity="0.35" stroke-width="1.4">
          <line x1="160" y1="90" x2="90" y2="50" /><line x1="160" y1="90" x2="230" y2="45" />
          <line x1="160" y1="90" x2="240" y2="130" /><line x1="160" y1="90" x2="80" y2="135" />
          <line x1="90" y1="50" x2="40" y2="70" /><line x1="230" y1="45" x2="285" y2="70" />
          <line x1="240" y1="130" x2="290" y2="150" /><line x1="80" y1="135" x2="35" y2="155" />
          <line x1="90" y1="50" x2="130" y2="20" /><line x1="230" y1="45" x2="190" y2="18" />
        </g>
        <g stroke="#ffd166" stroke-width="2.4"><line x1="160" y1="90" x2="240" y2="130" /><line x1="240" y1="130" x2="290" y2="150" /></g>
        <circle cx="160" cy="90" r="13" fill="#8b6cff" />
        <circle cx="90" cy="50" r="8" fill="#1f9cc6" /><circle cx="230" cy="45" r="8" fill="#e5468f" />
        <circle cx="240" cy="130" r="9" fill="#ffd166" /><circle cx="80" cy="135" r="7" fill="#2fa85a" />
        <circle cx="40" cy="70" r="5" fill="#c9761a" /><circle cx="285" cy="70" r="5" fill="#1f9cc6" />
        <circle cx="290" cy="150" r="6" fill="#ffd166" /><circle cx="35" cy="155" r="4" fill="#e5468f" />
        <circle cx="130" cy="20" r="4" fill="#2fa85a" /><circle cx="190" cy="18" r="4" fill="#c9761a" />
      </g>
    )
  }
  {
    slug === 'reverse-learning' && (
      <g>
        <path d="M30 150 C 90 150, 80 95, 140 95 S 200 40, 290 40" stroke="#342e7a" stroke-width="16" fill="none" stroke-linecap="round" />
        <path d="M30 150 C 90 150, 80 95, 140 95" stroke="#2fa85a" stroke-width="6" fill="none" stroke-linecap="round" />
        <circle cx="30" cy="150" r="10" fill="#2fa85a" />
        <circle cx="140" cy="95" r="12" fill="#ffd166" />
        <path d="M134 95 l4 4 8 -9" stroke="#110e33" stroke-width="3" fill="none" stroke-linecap="round" />
        <rect x="200" y="46" width="22" height="26" rx="5" fill="#e5468f" />
        <path d="M205 46 v-6 a6 6 0 0 1 12 0 v6" stroke="#e5468f" stroke-width="3.5" fill="none" />
        <circle cx="290" cy="40" r="10" fill="#1d1950" stroke="#bdb8ea" stroke-width="2" stroke-dasharray="4 3" />
        <g fill="#f4f2ff" opacity="0.9">
          <rect x="60" y="30" width="70" height="30" rx="10" fill="#262163" />
          <rect x="70" y="40" width="40" height="4" rx="2" />
          <rect x="70" y="49" width="26" height="4" rx="2" opacity="0.6" />
        </g>
      </g>
    )
  }
  {
    slug === 'forcingknight' && (
      <g>
        <g opacity="0.55">
          {Array.from({ length: 8 }).map((_, i) =>
            Array.from({ length: 5 }).map((__, j) => ((i + j) % 2 === 0 ? <rect x={i * 40} y={j * 40 - 10} width="40" height="40" fill="#262163" /> : null)),
          )}
        </g>
        <g stroke="#ffd166" stroke-width="1.6" opacity="0.85">
          <line x1="230" y1="40" x2="200" y2="85" /><line x1="230" y1="40" x2="260" y2="85" />
          <line x1="200" y1="85" x2="185" y2="125" /><line x1="200" y1="85" x2="215" y2="125" />
          <line x1="260" y1="85" x2="275" y2="125" />
        </g>
        <g fill="#ffd166"><circle cx="230" cy="40" r="6" /><circle cx="200" cy="85" r="5" /><circle cx="260" cy="85" r="5" /><circle cx="185" cy="125" r="4" /><circle cx="215" cy="125" r="4" /><circle cx="275" cy="125" r="4" /></g>
        <path
          d="M70 160 h80 v-14 h-8 c0-22 6-34 -2-58 c-6-16 -22-30 -40-32 l-4 -10 l-8 12 c-12 8 -22 22 -24 34 l10 6 l14 -10 c4 10 -18 24 -16 48 h-6 z"
          fill="#f4f2ff"
          stroke="#8b6cff"
          stroke-width="3"
          stroke-linejoin="round"
        />
        <circle cx="94" cy="72" r="3.5" fill="#110e33" />
      </g>
    )
  }
  {
    slug === 'lora-alerting' && (
      <g>
        <rect x="0" y="140" width="320" height="40" fill="#1d1950" />
        <path d="M30 168 q20 -8 40 0" stroke="#e5468f" stroke-width="3" fill="none" />
        <rect x="40" y="158" width="20" height="14" rx="4" fill="#e5468f" />
        <line x1="90" y1="140" x2="90" y2="50" stroke="#bdb8ea" stroke-width="4" />
        <circle cx="90" cy="46" r="6" fill="#ffd166" />
        <g stroke="#ffd166" fill="none" stroke-width="2.5" stroke-linecap="round" class="waves">
          <path d="M104 34 a20 20 0 0 1 0 24" /><path d="M114 26 a32 32 0 0 1 0 40" opacity="0.7" /><path d="M124 18 a44 44 0 0 1 0 56" opacity="0.45" />
        </g>
        <line x1="190" y1="140" x2="190" y2="70" stroke="#bdb8ea" stroke-width="3" opacity="0.7" />
        <circle cx="190" cy="66" r="4" fill="#1f9cc6" />
        <rect x="216" y="112" width="74" height="26" rx="9" fill="#2fa85a" />
        <path d="M228 112 l10 -14 h30 l12 14" fill="#2fa85a" />
        <rect x="240" y="101" width="24" height="9" rx="2" fill="#0b0925" />
        <circle cx="234" cy="140" r="7" fill="#0b0925" stroke="#bdb8ea" stroke-width="2" />
        <circle cx="274" cy="140" r="7" fill="#0b0925" stroke="#bdb8ea" stroke-width="2" />
        <rect x="246" y="80" width="14" height="14" rx="3" fill="#e5468f" />
        <rect x="252" y="83" width="2" height="5" fill="#f4f2ff" /><rect x="252" y="90" width="2" height="2" fill="#f4f2ff" />
      </g>
    )
  }
</svg>

<style>
  .art {
    display: block;
    width: 100%;
    height: 100%;
  }

  @media (prefers-reduced-motion: no-preference) {
    .blink {
      animation: cursor 1s steps(2) infinite;
    }

    .waves {
      animation: pulse 1.8s ease-in-out infinite;
      transform-origin: 90px 46px;
    }
  }

  @keyframes cursor {
    50% { opacity: 0; }
  }

  @keyframes pulse {
    50% { opacity: 0.35; transform: scale(1.08); }
  }
</style>
